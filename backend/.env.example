# Google OAuth (from Google Cloud Console > APIs & Services > Credentials) 
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Filled in automatically the first time you run `npm run auth`
GOOGLE_REFRESH_TOKEN=

# LLM providers: set an API key for any provider you want available in the
# "Write with" dropdown. Unset ones are simply hidden from the UI - you don't
# need all of them, just at least one. 

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI / ChatGPT (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (https://aistudio.google.com/apikey)
# Model names change often — if this one starts 404ing, check the model
# picker at aistudio.google.com for a current Flash-class free-tier model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local model via Ollama (https://ollama.com) - free, no API key, runs on your machine
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# App 
PORT=4000
